# Copie este arquivo para ".env" e ajuste os valores.
# DJANGO_DEBUG=1 só em desenvolvimento local. Em produção use 0.
DJANGO_DEBUG=1
# Gere uma chave nova com:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=troque-esta-chave-por-uma-gerada
# Hosts permitidos, separados por vírgula. Para testar no celular, inclua o IP do seu computador.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Nome exibido no topo do site
NOME_DO_JOGO=Zona Morta
# PostgreSQL (opcional). Se DB_NAME estiver vazio, usa SQLite.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
